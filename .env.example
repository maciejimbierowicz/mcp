MCP_PORT=3000
MCP_AUTH_TOKEN=replace-with-long-random-token
MCP_ALLOWED_HOSTS=
DRUPAL_BASE_URL=http://127.0.0.1:8888
DRUPAL_USERNAME=mcp_reader_local
DRUPAL_PASSWORD=replace-with-local-secret
MCP_WRITE_ENABLED=false
DRUPAL_WRITE_USERNAME=mcp_writer_local
DRUPAL_WRITE_PASSWORD=replace-with-separate-write-secret
DRUPAL_TIMEOUT_MS=30000
MCP_RATE_LIMIT_PER_MIN=30
MCP_RATE_BURST=10
MCP_HEAVY_CONCURRENCY=2
MCP_HEAVY_WAIT_MS=10000
MCP_MAX_RESPONSE_BYTES=2097152

# Destructive integration test: disposable npxtraining, landing_page, npxquiz NIDs.
TEST_WRITE_CONFIRM=false
TEST_WRITE_CONTENT_NIDS=
# Two disposable, readable NIDs of the same allowed content type.
TEST_WRITE_BULK_NIDS=
# Optional Google Tag Manager v2 read-only provider
GTM_ENABLED=false
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REFRESH_TOKEN=
GTM_ACCOUNT_ID=
GTM_TIMEOUT_MS=30000
