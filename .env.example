MCP_PORT=3000
MCP_AUTH_TOKEN=replace-with-long-random-token
MCP_ALLOWED_HOSTS=
DRUPAL_BASE_URL=http://127.0.0.1:8888
DRUPAL_USERNAME=mcp_reader_local
DRUPAL_PASSWORD=replace-with-local-secret
# How long to wait for one Drupal API call, in milliseconds (1000-120000).
# Keep it below the reverse proxy read timeout so this server can answer with a
# JSON-RPC error instead of the proxy dropping the connection.
DRUPAL_TIMEOUT_MS=30000
